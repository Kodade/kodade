{
  "name": "kodade",
  "private": true,
  "version": "1.4.14",
  "license": "Apache-2.0",
  "homepage": "https://kodade.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kodade/kodade.git"
  },
  "bugs": {
    "url": "https://github.com/Kodade/kodade/issues"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build --mode development-features",
    "build:development": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build --mode development-features",
    "build:public": "pnpm verify:public-source && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verify-public-release.mjs --config && pnpm licenses:verify",
    "build:cli": "esbuild cli/kodade-local/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/kodade-local.mjs",
    "build:modeld": "node scripts/stage-modeld.mjs",
    "stage:public-resources": "node scripts/stage-public-resources.mjs",
    "licenses:generate": "node scripts/generate-dependency-licenses.mjs",
    "licenses:verify": "node scripts/generate-dependency-licenses.mjs --verify",
    "check:version": "node scripts/check-release-version.mjs",
    "verify:public-source": "node scripts/verify-public-source.mjs",
    "vendor:kodskills": "node scripts/vendor-kodskills.mjs",
    "eval:local": "tsx scripts/kodlocal-eval/index.ts",
    "eval:local:typecheck": "tsc --noEmit -p scripts/kodlocal-eval/tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:public": "PATH=/usr/bin:$PATH tauri build --config src-tauri/tauri.public.conf.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:public": "vitest run --config vitest.public.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "smol-toml": "^1.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
